# npm audit surfaces the vulnerabilities that matter for THIS project.
#
# `audit-level=high` means CI and local `npm install` still surface high
# and critical severity findings (which would block a deploy), while
# suppressing moderate transitive dev-only warnings that aren't
# actionable — see the "//" comment in package.json for the two
# accepted transitive dependencies (esbuild via drizzle-kit,
# postcss via next). Both are dev-time only and cannot affect the
# deployed site.
#
# Reassess this setting whenever drizzle-kit merges its tsx-based
# replacement or Next.js 15.6+ ships with updated postcss.
audit-level=high

# Save exact versions on install so devs get identical dependency
# trees. Prevents "works on my machine" caused by minor bumps.
save-exact=false

# Skip the funding messages during install — cleaner CI logs.
fund=false
