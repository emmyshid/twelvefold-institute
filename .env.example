# ─── AI (server-only — NEVER expose to the browser) ──────────────
# The whole point of the proxy: this key lives on the server only.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Database (Postgres — Vercel Postgres, Neon, Supabase, etc.) ──
DATABASE_URL=postgres://user:password@host:5432/pattern_institute

# ─── Auth (Clerk) ────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Payments (Stripe) ───────────────────────────────────────────
# Get these from https://dashboard.stripe.com → Developers → API keys.
# Use test keys (sk_test_, pk_test_, whsec_test_) during development.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
# Publishable key is currently not needed (we use server-side Checkout
# Sessions and redirect — no Stripe.js in the browser). Add it here when
# you implement embedded forms or Stripe Elements.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx

# ─── Admin access ────────────────────────────────────────────────
# Comma-separated list of email addresses allowed to access /admin.
# Anyone signed in with an email NOT on this list is redirected to home.
# To grant or revoke admin, change this var in Vercel and redeploy.
ADMIN_EMAILS=emmyshid@gmail.com

# ─── Transactional email (Resend) ────────────────────────────────
# Sign up at resend.com → add and verify twelvefold.institute → API Keys → create.
# Verify the sender domain by adding the SPF + DKIM CNAMEs Resend gives you in
# Vercel DNS (similar to the Clerk CNAMEs you already added).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# The verified sender. Must be on a domain you've verified in Resend.
# Format: "Display Name <email@domain>"
RESEND_FROM_EMAIL=Twelvefold Institute <hello@twelvefold.institute>

# Where admin notifications go (new applications, consults, payments).
# Should be a real inbox you check. Replies to outbound emails also route here.
ADMIN_NOTIFICATION_EMAIL=emmyshid@gmail.com
